# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=secure_password_123
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672

# To connect from other services
RABBITMQ_URL=amqp://admin:secure_password_123@rabbitmq:5672/

# PostgreSQL
# Use these variables to connect to the PostgreSQL database
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=auth_pass
POSTGRES_DB=auth_db